# -----------------------------------------------------------------------
# LaraKit - Environment Configuration
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------------


# -----------------------------------------------------------------------
# App
# -----------------------------------------------------------------------

# The name of your application. Shown in emails, notifications, and UI.
APP_NAME=LaraKit

# Environment: local | staging | production
APP_ENV=local

# Generated automatically. Run: php artisan key:generate
APP_KEY=

# Set to false in production - never expose errors publicly.
APP_DEBUG=true

# The full URL of your application (no trailing slash).
# Docker: use http://localhost:8080
APP_URL=http://localhost:8000

APP_TIMEZONE=UTC


# -----------------------------------------------------------------------
# Localization
# -----------------------------------------------------------------------

# Default and fallback locale for the application.
# Supported locales are defined in config/larakit.php
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Default locale for the LaraKit locale switcher.
LARAKIT_DEFAULT_LOCALE=en


# -----------------------------------------------------------------------
# Maintenance Mode
# -----------------------------------------------------------------------

APP_MAINTENANCE_DRIVER=file

# Secret bypass token for maintenance mode.
# Access the app while in maintenance mode via: /?secret=YOUR_SECRET
# Set a strong random string in production.
LARAKIT_MAINTENANCE_SECRET=


# -----------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------

# Cost factor for bcrypt password hashing. 12 is the recommended minimum.
# Higher = more secure but slower. Never go below 10.
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# debug | info | notice | warning | error | critical | alert | emergency
# Use "error" in production to reduce noise.
LOG_LEVEL=debug


# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

DB_CONNECTION=mysql

# Local development: 127.0.0.1
# Docker: mysql (the container name on the shared network)
DB_HOST=127.0.0.1

# Local development: 3306
# Docker: 3307 (mapped to avoid conflict with local MySQL)
DB_PORT=3306

DB_DATABASE=larakit
DB_USERNAME=
DB_PASSWORD=


# -----------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# -----------------------------------------------------------------------
# Broadcasting / Filesystem / Queue
# -----------------------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# LaraKit uses Redis for queues. Horizon depends on this.
# Use "sync" in testing environments to run jobs immediately.
QUEUE_CONNECTION=redis


# -----------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------

# LaraKit uses database cache by default (no extra setup needed).
# Switch to "redis" in production for better performance.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1


# -----------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------

# Used for queues (Horizon) and cache.
# Docker: set REDIS_HOST=redis (the container name)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# -----------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------

# For local development use "log" - emails written to storage/logs/laravel.log
# For production use "smtp", "mailgun", "resend", "ses", etc.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# The from address for all outgoing emails. Set to your domain in production.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------
# AWS (optional - only needed if using S3 for media storage)
# -----------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# -----------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"


# -----------------------------------------------------------------------
# Laravel Telescope (Debug Dashboard)
# -----------------------------------------------------------------------

# Set to false in production or remove entirely.
TELESCOPE_ENABLED=true

# Only this email can access /telescope in production.
TELESCOPE_ACCESS_EMAIL=


# -----------------------------------------------------------------------
# LaraKit Notifications & Mail Content
# -----------------------------------------------------------------------

# Footer text shown in all admin notification emails.
LARAKIT_NOTIFICATION_FOOTER=

# Subject line for the welcome email sent to new users.
LARAKIT_WELCOME_EMAIL_SUBJECT=


# -----------------------------------------------------------------------
# Sentry (Error Tracking)
# -----------------------------------------------------------------------

# Leave empty in local/staging - Sentry only activates in production.
# Get your DSN from: https://sentry.io
SENTRY_LARAVEL_DSN=

# Percentage of requests to trace for performance monitoring (0.0 - 1.0).
# 0.1 = 10% of requests. Lower in high-traffic production apps.
SENTRY_TRACES_SAMPLE_RATE=0.1
